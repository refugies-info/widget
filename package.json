{
  "name": "widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "lint": "biome lint .",
    "format": "biome check --write --linter-enabled=false .",
    "check-types": "tsc --noEmit",
    "check-types:front": "pnpm --filter widget-front check-types",
    "build:front": "pnpm --filter widget-front build",
    "test": "vitest run"
  },
  "pnpm": {
    "overrides": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  },
  "dependencies": {
    "@algolia/client-search": "^5.61.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
